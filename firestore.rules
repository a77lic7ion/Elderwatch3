rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidStatus(status) {
      return status in ['ok', 'not_ok', 'awaiting'];
    }

    function isValidCheckin(data) {
      return data.keys().hasAll(['homeId', 'residentId', 'date', 'status', 'timestamp'])
        && data.homeId is string && data.homeId.size() > 0 && data.homeId.size() <= 100
        && data.residentId is string && data.residentId.size() > 0 && data.residentId.size() <= 100
        && data.date is string && data.date.size() == 10
        && isValidStatus(data.status)
        && data.timestamp is string && data.timestamp.size() <= 50;
    }

    // System connection test doc
    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Residents roster collection
    match /residents/{residentId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
      allow delete: if false;
    }

    // Daily check-ins collection
    match /checkins/{checkinId} {
      allow read: if true;
      allow create, update: if isValidCheckin(request.resource.data);
      allow delete: if false;
    }

    // Device bindings collection
    match /device_bindings/{bindingId} {
      allow read, write: if true;
    }
  }
}
