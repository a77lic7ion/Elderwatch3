{
  "buildCommand": "npm run build",
  "framework": "vite",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/link", "destination": "/index.html" },
    { "source": "/link/:code", "destination": "/index.html" },
    { "source": "/checkin", "destination": "/index.html" },
    { "source": "/checkin/:residentId", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/daily-reset", "schedule": "0 22 * * *" }
  ]
}
